{
  "name": "Appointment",
  "type": "object",
  "properties": {
    "nail_pro_id": {
      "type": "string",
      "description": "ID da manicure"
    },
    "client_name": {
      "type": "string",
      "description": "Nome da cliente"
    },
    "client_id": {
      "type": "string",
      "description": "ID da cliente vinculada"
    },
    "client_whatsapp": {
      "type": "string",
      "description": "WhatsApp da cliente"
    },
    "service_id": {
      "type": "string",
      "description": "ID do servi\u00e7o"
    },
    "service_name": {
      "type": "string",
      "description": "Nome do servi\u00e7o"
    },
    "price": {
      "type": "number",
      "description": "Valor cobrado"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data do agendamento"
    },
    "time": {
      "type": "string",
      "description": "Hor\u00e1rio (HH:MM)"
    },
    "duration": {
      "type": "number",
      "description": "Dura\u00e7\u00e3o em minutos"
    },
    "status": {
      "type": "string",
      "enum": [
        "confirmado",
        "pendente",
        "cancelado",
        "concluido"
      ],
      "default": "pendente"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    },
    "booked_online": {
      "type": "boolean",
      "default": false,
      "description": "Agendado pela p\u00e1gina p\u00fablica"
    }
  },
  "required": [
    "nail_pro_id",
    "client_name",
    "service_name",
    "date",
    "time"
  ]
}