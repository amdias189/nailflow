{
  "name": "Service",
  "type": "object",
  "properties": {
    "nail_pro_id": {
      "type": "string",
      "description": "ID da manicure dona do servi\u00e7o"
    },
    "name": {
      "type": "string",
      "description": "Nome do servi\u00e7o"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do servi\u00e7o"
    },
    "price": {
      "type": "number",
      "description": "Valor em reais"
    },
    "duration": {
      "type": "number",
      "description": "Dura\u00e7\u00e3o em minutos"
    },
    "active": {
      "type": "boolean",
      "default": true,
