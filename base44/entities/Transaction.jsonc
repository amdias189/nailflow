{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "nail_pro_id": {
      "type": "string",
      "description": "ID da manicure"
    },
    "type": {
      "type": "string",
      "enum": [
        "entrada",
        "saida"
      ],
      "description": "Tipo da transa\u00e7\u00e3o"
    },
    "amount": {
      "type": "number",
      "description": "Valor"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o"
    },
    "category": {
      "type": "string",
      "enum": [
        "servico",
        "produto",
        "aluguel",
        "material",
        "transporte",
        "alimentacao",
        "marketing",
        "outros"
      ],
      "description": "Categoria"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "appointment_id": {
      "type": "string",
      "description": "ID do agendamento vinculado"
    }
  },
  "required": [
    "nail_pro_id",
    "type",
    "amount",
    "description",
    "date"
  ]
}